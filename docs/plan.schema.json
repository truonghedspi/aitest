{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitest.local/plan.schema.json",
  "title": "aitest test plan",
  "type": "object",
  "required": [
    "id",
    "name",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Mã plan, duy nhất trong dự án."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Namespace action mà plan được dùng, ví dụ http, db."
    },
    "envs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Môi trường được chạy plan (envs/<tên>.yml); không khai báo thì chạy được mọi môi trường."
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hệ thống trong catalog (systems/<id>/service.yml) mà plan dùng tới, ví dụ order-service. Cung cấp biến {{<id>.url}} theo môi trường."
    },
    "inputs": {
      "type": "object",
      "description": "Đầu vào của lượt chạy, phân giải một lần trước mọi case và dùng như biến {{tên}}. Nguồn theo thứ tự: người chạy điền, fill, prepare, default.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "desc": {
            "type": "string"
          },
          "default": {
            "description": "Giá trị mặc định; hỗ trợ ${env.TÊN}."
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "fill": {
            "type": "array",
            "items": null,
            "description": "Bước lấy giá trị xác định; một bước phải save vào tên input."
          },
          "prepare": {
            "type": "string",
            "description": "Mô tả bằng lời cách chuẩn bị; agent thực hiện và trả giá trị từ evidence."
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Namespace agent được dùng khi prepare; mặc định là requires."
          },
          "require": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string"
              },
              "value": {}
            },
            "required": [
              "op"
            ],
            "description": "Điều kiện giá trị phải thoả; không thoả thì lượt chạy bị chặn."
          },
          "cleanup": {
            "type": "array",
            "items": null,
            "description": "Bước dọn sau mọi case, chạy khi giá trị lấy bằng fill."
          }
        }
      }
    },
    "vars": {
      "type": "object",
      "description": "Biến dùng trong steps qua cú pháp {{tên}}. Hỗ trợ ${env.NAME:-mặc định}."
    },
    "context": {
      "type": "string",
      "description": "Bối cảnh nghiệp vụ cho agent."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "description": "Giới hạn thời gian, đơn vị giây."
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expect": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "desc"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "desc": {
                  "type": "string"
                },
                "check": {
                  "type": "object",
                  "required": [
                    "op"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "contains",
                        "matches",
                        "exists",
                        "not_exists"
                      ]
                    },
                    "value": {},
                    "expr": {
                      "type": "string",
                      "description": "Công thức tính giá trị mong đợi, thay cho value. Biến lấy từ evidence khi assert. Ví dụ: round(qty * price * 0.0015, 2)."
                    }
                  },
                  "not": {
                    "required": [
                      "value",
                      "expr"
                    ]
                  }
                }
              }
            }
          },
          "setup": {
            "$ref": "#/$defs/fixtures"
          },
          "teardown": {
            "$ref": "#/$defs/fixtures"
          }
        }
      }
    },
    "setup": {
      "$ref": "#/$defs/fixtures",
      "description": "Chạy trước mỗi case, không qua AI."
    },
    "teardown": {
      "$ref": "#/$defs/fixtures",
      "description": "Chạy sau mỗi case, kể cả khi case lỗi."
    }
  },
  "$defs": {
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "description": "Tên action, ví dụ dbadmin_query."
          },
          "args": {
            "type": "object"
          },
          "save": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Lưu giá trị từ kết quả thành biến: { tên: path }."
          },
          "desc": {
            "type": "string"
          }
        }
      }
    }
  }
}
